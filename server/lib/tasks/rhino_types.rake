# frozen_string_literal: true

# Deterministic, dependency-free TypeScript type export.
#
# The engine's `rhino:export_types` shells out to `npx openapi-typescript`,
# which is not installed in this workspace and hangs the run. This task emits
# the same `client/src/rhino.d.ts` shape (one interface per registered model,
# every field optional) using only the Ruby stdlib, so the frontend build
# evidence (`client/src/rhino.d.ts` must be a nonempty regular file) is always
# reproducible.
namespace :rhino do
  desc "Generate client/src/rhino.d.ts from registered Rhino models (no npx)"
  task export_types_local: :environment do
    require "json"

    output = ENV["OUTPUT"] || File.expand_path("../../../client/src/rhino.d.ts", __dir__)

    schemas = {}
    Rhino.config.models.each do |slug, class_name|
      klass = begin
        class_name.constantize
      rescue NameError
        next
      end
      next unless klass.respond_to?(:columns_hash)

      interface = slug.to_s.underscore.singularize.camelize
      props = {}
      klass.columns_hash.each do |name, column|
        type = case column.type.to_s.downcase
               when "integer", "int", "bigint", "smallint", "tinyint", "mediumint"
                 "number"
               when "decimal", "float", "double", "real", "numeric"
                 "number"
               when "boolean", "bool"
                 "boolean"
               when "json", "jsonb"
                 "Record<string, unknown>"
               else
                 "string"
               end
        type = "#{type} | null" if column.null
        props[name] = type
      end
      schemas[interface] = props
    end

    lines = []
    lines << "// This file is auto-generated by `rails rhino:export_types_local`."
    lines << "// Do not edit by hand. All fields are optional: Rhino's policy layer"
    lines << "// controls which fields each role can actually read."
    lines << ""
    schemas.each do |interface, props|
      lines << "export interface #{interface} {"
      props.each { |name, type| lines << "  #{name}?: #{type};" }
      lines << "}"
      lines << ""
    end

    FileUtils.mkdir_p(File.dirname(output))
    File.write(output, lines.join("\n"))
    puts "Generated #{schemas.size} interfaces at #{output}"
  end
end
